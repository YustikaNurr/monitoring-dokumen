        border-radius: 20px;
        background: linear-gradient(135deg, #ffffff, #fff9d9);
        border: 1px solid #f1df80;
        box-shadow: 0 12px 32px rgba(225, 29, 42, 0.14);
        margin-bottom: 14px;
    }

    .brand-logo-box img {
        width: 66px;
        height: 66px;
        object-fit: contain;
    }

    .brand-top-title {
        margin: 0 0 4px;
        font-size: 32px;
        font-weight: 800;
        color: var(--text, #1e293b);
        letter-spacing: -0.02em;
    }

    .brand-top-sub {
        margin: 0;
        font-size: 19px;
        font-weight: 600;
        color: var(--primary, #E11D2A);
    }

    /* Split Card Container */
    .split-card {
        display: flex;
        flex-direction: row;
        background: #ffffff;
        border-radius: 28px;
        box-shadow: 
            0 20px 50px rgba(225, 29, 42, 0.08), 
            0 8px 24px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        width: 1140px;
        max-width: 100%;
        height: 620px;
        border: 1px solid rgba(214, 225, 236, 0.7);
        position: relative;
    }

    /* Left Panel: Info Panel (Sudah punya akun) */
    .info-panel {
        flex: 1;
        width: 50%;
        height: 100%;
        background: linear-gradient(135deg, #E11D2A 0%, #C81E2B 50%, #A5131E 100%);
        position: relative;
        display: flex;
        flex-direction: column;
