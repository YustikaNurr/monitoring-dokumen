<style id="auth-page-style">
    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin { animation: spin 1s linear infinite; }

    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 20px;
        box-sizing: border-box;
    }

    body.auth-page {
        background: #99111b url('{{ asset('images/bg login regis.png') }}') center / cover no-repeat fixed;
    }

    .auth-page .content,
    .auth-page .container {
        width: 100%;
        max-width: none;
    }

    .login-container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
    }

    /* Top Brand Header (Di Luar Card) */
    .brand-top-header {
        text-align: center;
        margin-bottom: 24px;
    }

    .brand-logo-box {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 76px;
