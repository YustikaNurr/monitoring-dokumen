        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
        box-sizing: border-box;
    }

    .outline-pill-btn:hover {
        background: #ffffff;
        color: #E11D2A;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);
        transform: translateY(-1px);
    }

    /* Right Panel: Form Register */
    .form-panel {
        flex: 1;
        width: 50%;
        height: 100%;
        padding: 44px 48px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #ffffff;
        position: relative;
        z-index: 2;
        box-sizing: border-box;
        will-change: transform;
    }

    .form-top {
        display: flex;
        flex-direction: column;
    }

    .form-heading {
        margin: 0 0 6px;
        font-size: 30px;
        font-weight: 800;
        color: #1e293b;
        letter-spacing: -0.02em;
    }

    .form-subheading {
        margin: 0 0 24px;
        font-size: 16px;
        color: #64748b;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px 20px;
    }

    .form-group {
        margin-bottom: 0;
    }

    .form-group.span-2 {
        grid-column: span 2;
    }

    .input-label {
        display: block;
        margin-bottom: 6px;
        font-size: 16px;
        font-weight: 600;
        color: #1e293b;
    }

    .field-control {
        position: relative;
    }

    .field-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        width: 20px;
        height: 20px;
        color: #8E8E93;
        pointer-events: none;
        transition: color .2s ease;
    }

    .custom-input {
        width: 100%;
        padding: 14px 18px 14px 50px;
        border: 1px solid rgba(214, 225, 236, 0.9);
        border-radius: 14px;
        font-size: 17px;
        background: #f8fafc;
        color: #1e293b;
        transition: all .2s ease;
        box-sizing: border-box;
    }

    .custom-input:focus {
        outline: none;
        border-color: #E11D2A !important;
        background: #ffffff !important;
        box-shadow: 0 0 0 4px rgba(225, 29, 42, 0.12) !important;
    }

    .field-control:focus-within .field-icon,
    .unit-select:focus-within > .field-icon {
        color: #E11D2A;
    }

    .password-toggle {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        padding: 4px;
        cursor: pointer;
        color: #8E8E93;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color .2s;
    }

    .password-toggle:hover {
        color: #E11D2A;
    }

    /* Unit Custom Select */
    .unit-select {
        position: relative;
    }

    .unit-select-trigger {
        width: 100%;
        min-height: 52px;
        padding: 14px 44px 14px 50px;
        border: 1px solid rgba(214, 225, 236, 0.9);
        border-radius: 14px;
        background: #f8fafc;
        color: #1e293b;
        font: inherit;
        font-size: 17px;
        text-align: left;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all .2s ease;
        box-sizing: border-box;
    }

    .unit-select-trigger > svg:last-child {
        width: 18px;
        height: 18px;
        color: #8E8E93;
        flex-shrink: 0;
    }

    .unit-select-trigger:focus {
        outline: none;
        border-color: #E11D2A !important;
        background: #ffffff !important;
        box-shadow: 0 0 0 4px rgba(225, 29, 42, 0.12) !important;
    }

    .unit-select-options {
        position: absolute;
        z-index: 10;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        display: none;
        max-height: 220px;
        overflow-y: auto;
        padding: 6px;
        border: 1px solid rgba(214, 225, 236, 0.9);
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 12px 28px rgba(10, 40, 74, 0.14);
    }

    .unit-select.is-open .unit-select-options { display: grid; gap: 2px; }

    .unit-select-options button {
        border: 0;
        border-radius: 10px;
        padding: 10px 14px;
        background: transparent;
        color: #1e293b;
        font: inherit;
        font-size: 17px;
        text-align: left;
        cursor: pointer;
        transition: background .15s;
    }

    .unit-select-options button:hover,
    .unit-select-options button.is-selected {
        background: #fff1f2;
        color: #E11D2A;
    }

    .form-bottom {
        margin-top: 24px;
    }

    .submit-btn {
        width: 100%;
        padding: 15px 32px;
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(135deg, #E11D2A 0%, #B91C1C 100%);
        border: none;
        border-radius: 36px;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(225, 29, 42, 0.28);
        transition: all .25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
    }

    .submit-btn:hover {
        background: linear-gradient(135deg, #f32331 0%, #99111b 100%);
        box-shadow: 0 14px 28px rgba(225, 29, 42, 0.38);
        transform: translateY(-1px);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    .mobile-register-link {
        display: none;
        margin-top: 18px;
        text-align: center;
        font-size: 16px;
        color: #64748b;
    }

    .register-anchor {
        color: #E11D2A;
        font-weight: 700;
        text-decoration: none;
    }

    .register-anchor:hover {
        text-decoration: underline;
    }

    .text-danger-msg {
        display: block;
        margin-top: 5px;
        font-size: 13.5px;
        color: #ef4444;
    }

    .border-danger {
        border-color: #ef4444 !important;
    }

    .card-footer-text {
        text-align: center;
        margin-top: 18px;
        font-size: 15.5px;
        color: var(--muted, #8E8E93);
        opacity: 0.8;
    }

    .card-footer-text p {
        margin: 2px 0;
    }

    /* Responsive untuk Tablet & Mobile */
    @media (max-width: 860px) {
        .split-card {
            flex-direction: column;
            border-radius: 20px;
        }

        .info-panel {
            order: 2;
            padding: 32px 24px;
        }

        .form-panel {
            order: 1;
            padding: 32px 24px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.span-2 {
            grid-column: span 1;
        }

        .info-heading {
            font-size: 26px;
        }

        .info-desc {
            font-size: 16px;
        }

        .form-heading {
            font-size: 26px;
        }

        .mobile-register-link {
            display: block;
        }
    }

    /* Animasi panel saling bertukar posisi: Register -> Login */
    @keyframes formSlideRight {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100%); }
    }
    @keyframes infoSlideRight {
        0% { transform: translateX(0); }
        100% { transform: translateX(100%); }
    }
    .split-card.is-leaving-right .form-panel {
        animation: formSlideRight 0.38s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .split-card.is-leaving-right .info-panel {
        animation: infoSlideRight 0.38s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes authTextLeave {
        from { opacity: 1; transform: translateX(0); }
        to { opacity: 0; transform: translateX(-14px); }
    }

    @keyframes authTextEnter {
        from { opacity: 0; transform: translateX(14px); }
        to { opacity: 1; transform: translateX(0); }
    }

    .split-card.is-leaving-right :is(.form-heading, .form-subheading, .input-label, .info-heading, .info-desc, .outline-pill-btn, .submit-btn, .mobile-register-link) {
        animation: authTextLeave 0.26s ease-out forwards;
    }

    .split-card.is-entering-text :is(.form-heading, .form-subheading, .input-label, .remember-label, .info-heading, .info-desc, .outline-pill-btn, .submit-btn, .mobile-register-link) {
        animation: authTextEnter 0.46s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
</style>

<script>
    function initAuthPage() {
        const bindPasswordToggle = (buttonId, inputId, openId, closedId) => {
            const button = document.getElementById(buttonId);
            const input = document.getElementById(inputId);
            const openIcon = document.getElementById(openId);
            const closedIcon = document.getElementById(closedId);

            if (!button || !input || button.dataset.bound) return;
            button.dataset.bound = 'true';
            button.addEventListener('click', function() {
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                if (openIcon) openIcon.style.display = isPassword ? 'none' : 'block';
                if (closedIcon) closedIcon.style.display = isPassword ? 'block' : 'none';
            });
        };

        bindPasswordToggle('togglePassword', 'password', 'eyeOpen', 'eyeClosed');
        bindPasswordToggle('togglePasswordConfirm', 'password_confirmation', 'eyeOpenConfirm', 'eyeClosedConfirm');

        const form = document.querySelector('form');
        const btnText = document.getElementById('btnText');
        const btnLoading = document.getElementById('btnLoading');
        const submitBtn = document.querySelector('.submit-btn');

        if (form && !form.dataset.bound) {
            form.dataset.bound = 'true';
            form.addEventListener('submit', function() {
                if (submitBtn) submitBtn.disabled = true;
                if (btnText) btnText.style.display = 'none';
                if (btnLoading) btnLoading.style.display = 'inline-flex';
            });
        }

        const unitSelect = document.querySelector('.unit-select');
        const unitTrigger = unitSelect?.querySelector('.unit-select-trigger');
        const unitInput = document.getElementById('unit_id');
        const unitLabel = document.getElementById('unitLabel');
        const unitOptions = unitSelect?.querySelectorAll('[role="option"]') ?? [];

        if (unitSelect && unitTrigger && unitInput && unitLabel && !unitSelect.dataset.bound) {
            unitSelect.dataset.bound = 'true';
            unitOptions.forEach(function(option) {
                if (option.dataset.value === unitInput.value) {
                    unitLabel.textContent = option.textContent.trim();
                    option.classList.add('is-selected');
                }

                option.addEventListener('click', function() {
                    unitInput.value = option.dataset.value;
                    unitLabel.textContent = option.textContent.trim();
                    unitOptions.forEach(item => item.classList.remove('is-selected'));
                    option.classList.add('is-selected');
                    unitSelect.classList.remove('is-open');
                    unitTrigger.setAttribute('aria-expanded', 'false');
                });
            });

            unitTrigger.addEventListener('click', function() {
                const isOpen = unitSelect.classList.toggle('is-open');
                unitTrigger.setAttribute('aria-expanded', String(isOpen));
            });

            document.addEventListener('click', function(event) {
                if (!unitSelect.contains(event.target)) {
                    unitSelect.classList.remove('is-open');
                    unitTrigger.setAttribute('aria-expanded', 'false');
                }
            });
        }

        document.querySelectorAll('.transition-link').forEach(link => {
            if (link.dataset.bound) return;
            link.dataset.bound = 'true';
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const targetUrl = this.href;
                const direction = this.dataset.direction;
                const card = document.querySelector('.split-card');

                if (card) {
                    card.classList.add(direction === 'left' ? 'is-leaving-left' : 'is-leaving-right');
                }

                fetch(targetUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(response => response.text())
                    .then(html => {
                        const doc = new DOMParser().parseFromString(html, 'text/html');
                        const nextCard = doc.querySelector('.split-card');
                        const nextStyle = doc.querySelector('#auth-page-style');
                        const currentStyle = document.querySelector('#auth-page-style');
                        const nextTitle = doc.querySelector('title')?.textContent;

                        if (!card || !nextCard || !nextStyle || !currentStyle) {
                            window.location.href = targetUrl;
                            return;
                        }

                        nextCard.classList.add('is-entering-text');

                        setTimeout(function() {
                            currentStyle.replaceWith(nextStyle);
                            card.replaceWith(nextCard);
                            if (nextTitle) document.title = nextTitle;
                            window.history.pushState({}, '', targetUrl);
                            initAuthPage();

                            setTimeout(function() {
                                nextCard.classList.remove('is-entering-text');
                            }, 360);
                        }, 150);
                    })
                    .catch(() => {
                        window.location.href = targetUrl;
                    });
            });
        });
    }

    document.addEventListener('DOMContentLoaded', initAuthPage);
    window.addEventListener('popstate', function() {
        window.location.reload();
    });
</script>
@endsection
