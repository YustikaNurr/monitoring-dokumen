        align-items: center;
        text-align: center;
        padding: 44px 48px;
        color: #ffffff;
        overflow: hidden;
        box-sizing: border-box;
        will-change: transform;
    }

    /* Background Geometris */
    .bg-shape {
        position: absolute;
        pointer-events: none;
    }

    .shape-diamond-top {
        width: 140px;
        height: 140px;
        background: rgba(255, 255, 255, 0.08);
        transform: rotate(45deg);
        border-radius: 24px;
        top: -30px;
        right: -30px;
    }

    .shape-diamond-bottom {
        width: 160px;
        height: 160px;
        background: rgba(255, 255, 255, 0.08);
        transform: rotate(45deg);
        border-radius: 28px;
        bottom: -40px;
        left: -40px;
    }

    .shape-circle {
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
        bottom: 5%;
        right: -10%;
    }

    .info-body {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
